# Copy to .env and fill in. Never commit .env.

# Database / queue / object store
BNY_DATABASE_URL=postgresql+psycopg://bny:bny@localhost:5432/bny
BNY_REDIS_URL=redis://localhost:6379/0
BNY_OBJECT_STORE_ENDPOINT=http://localhost:9000
BNY_OBJECT_STORE_BUCKET=bny-artifacts
BNY_OBJECT_STORE_KEY=bny
BNY_OBJECT_STORE_SECRET=bnybnybny

# Solver
BNY_SOLVER=glpk            # glpk | gurobi | cplex
BNY_MAX_PARALLEL_SIMS=8

# Knowledge base
BNY_GEM_LIBRARY_PATH=./data/gems

# Anthropic — for runtime LLM features (byproduct text parsing, report narration)
ANTHROPIC_API_KEY=

# Auth
BNY_API_TOKEN_SIGNING_KEY=change-me
